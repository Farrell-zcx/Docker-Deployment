# ===========================================================
# Environment Variables untuk Docker Compose
# ===========================================================
# Copy file ini menjadi .env di samping docker-compose.yml
# Sesuaikan nilainya sebelum menjalankan docker compose up
# ===========================================================

# --- DATABASE ---
MYSQL_ROOT_PASSWORD=ganti_dengan_password_kuat

# --- SMTP EMAIL (Gmail App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_USER=emailkamu@gmail.com
SMTP_PASS=abcdefghijklmnop
SMTP_PORT=587

# --- SSO ENGINE ---
SSO_BASE_URL=http://sso.IP_VPS.sslip.io/

# --- MYMEMBER ---
MYMEMBER_BASE_URL=http://mymember.IP_VPS.sslip.io/
MYMEMBER_EMAIL_FROM=emailkamu@gmail.com
MYMEMBER_SSO_CLIENT_ID=mymember-app
MYMEMBER_SSO_REDIRECT=http://mymember.IP_VPS.sslip.io/auth/callback

# --- INVENTORY ---
INVENTORY_BASE_URL=http://inventory.IP_VPS.sslip.io
INVENTORY_APP_KEY=base64:fJ6BPmLWPLjr4i6VrHBmX3fDZ05SPIQ0hJrnldlToeE=
INVENTORY_SSO_REDIRECT=http://inventory.IP_VPS.sslip.io/callback
