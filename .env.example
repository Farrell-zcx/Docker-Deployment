# ===========================================================
# Environment Variables untuk Docker Compose
# ===========================================================
# Copy file ini menjadi .env di samping docker-compose.yml
# Sesuaikan nilainya sebelum menjalankan docker compose up
# ===========================================================

# --- DATABASE ---
MYSQL_ROOT_PASSWORD=ganti_dengan_password_kuat

# --- SMTP EMAIL ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_USER=cae5b118b7e523
SMTP_PASS=08e19fa24122c3
SMTP_PORT=2525

# --- SSO ENGINE ---
SSO_BASE_URL=http://sso.domain.com/

# --- MYMEMBER ---
MYMEMBER_BASE_URL=http://mymember.domain.com/
MYMEMBER_EMAIL_FROM=noreply@mymember.id
MYMEMBER_SSO_CLIENT_ID=mymember-app
MYMEMBER_SSO_REDIRECT=http://mymember.domain.com/auth/callback
